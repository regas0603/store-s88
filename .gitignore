### Node
# Dependencies
node_modules/

# Logs
*.log

# Runtime data
*.pid
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output

# Build output
dist/
build/Release

# dynmod — private key ký module .bytecode (Ed25519).
# TUỐI TÚY: chỉ private key là bí mật. Public key (.pub.pem/.pub.hex) vẫn
# commit — app nhúng pubkey qua --dart-define=DYNMOD_ED25519_PUBKEY nên cần
# biết nó để sinh app khớp. Private key KHÔNG BAO GIỜ lên git: lộ nó là
# lập được module hợp lệ theo góc nhìn app. Sinh lại: dynpush.sh keys.
configs/dynmod/*.pem
!configs/dynmod/*.pub.pem
!configs/dynmod/*.pub.hex
loading_kit/dyn_loader/test/vectors/key.pem

